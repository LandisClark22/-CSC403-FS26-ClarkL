\question \emph{Section 1.5, Exercise 8}

\begin{parts}

\part Show that
\[
(P\to Q)\land(Q\to R)
\]
is equivalent to
\[
(P\to R)\land\big[(P\leftrightarrow Q)\lor(R\leftrightarrow Q)\big].
\]

We use the equivalences
\[
P\to Q\equiv\neg P\lor Q,
\qquad
Q\to R\equiv\neg Q\lor R,
\]
and
\[
P\leftrightarrow Q\equiv(P\land Q)\lor(\neg P\land\neg Q).
\]

A truth table verifies the equivalence:

\[
\begin{array}{c c c|c|c}
P&Q&R&(P\to Q)\land(Q\to R)&
(P\to R)\land[(P\leftrightarrow Q)\lor(R\leftrightarrow Q)]\\
\hline
T&T&T&T&T\\
T&T&F&F&F\\
T&F&T&F&F\\
T&F&F&F&F\\
F&T&T&T&T\\
F&T&F&F&F\\
F&F&T&T&T\\
F&F&F&T&T
\end{array}
\]

The two columns are identical in every possible case for $P,Q,R$. Therefore,
\[
\boxed{(P\to Q)\land(Q\to R)
\equiv
(P\to R)\land[(P\leftrightarrow Q)\lor(R\leftrightarrow Q)]}.
\]

\part Show that
\[
(P\to Q)\lor(Q\to R)
\]
is a tautology.

Using implication,
\[
(P\to Q)\lor(Q\to R)
\equiv
(\neg P\lor Q)\lor(\neg Q\lor R).
\]
By associativity and commutativity of $\lor$,
\[
(\neg P\lor Q)\lor(\neg Q\lor R)
\equiv
\neg P\lor Q\lor\neg Q\lor R.
\]
Since
\[
Q\lor\neg Q\equiv T,
\]
we get
\[
\neg P\lor T\lor R\equiv T.
\]
Therefore,
\[
\boxed{(P\to Q)\lor(Q\to R)}
\]
is a tautology.

\end{parts}

