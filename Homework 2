\question \emph{Section 1.5, Exercise 2}

Analyze the logical form of each statement.

\begin{parts}

\part ``Mary will sell her house only if she can get a good price and find a nice apartment.''

Let
\[
P=\text{Mary will sell her house},
\]
\[
Q=\text{Mary can get a good price},
\]
\[
R=\text{Mary can find a nice apartment}.
\]
The phrase ``$P$ only if $Q$'' means $P\to Q$. Therefore the logical form is
\[
\boxed{P\to(Q\land R)}.
\]

\part ``Having both a good credit history and an adequate down payment is a necessary condition for getting a mortgage.''

Let
\[
P=\text{having a good credit history and an adequate down payment},
\]
\[
Q=\text{getting a mortgage}.
\]
Since $P$ is a necessary condition for $Q$, getting a mortgage implies $P$. Thus,
\[
\boxed{Q\to P}.
\]

\part ``John will drop out of school, unless someone stops him.''

Let
\[
P=\text{John will drop out of school},
\]
\[
Q=\text{someone stops John}.
\]
The statement says that if nobody stops John, then he will drop out. Therefore,
\[
\boxed{\neg Q\to P}.
\]
An equivalent form is
\[
\boxed{P\lor Q}.
\]

\part ``If $x$ is divisible by either 4 or 6, then it isn't prime.''

Let
\[
P=\text{$x$ is divisible by 4 or 6},
\]
\[
Q=\text{$x$ is prime}.
\]
The statement has the form ``if $P$, then not $Q$,'' so its logical form is
\[
\boxed{P\to\neg Q}.
\]

\end{parts}

