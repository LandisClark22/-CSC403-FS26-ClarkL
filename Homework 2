\question \emph{Section 1.4, Exercise 8}

Verify the following set identities.

\begin{parts}

\part
\[
(A\setminus B)\cap C=(A\cap C)\setminus B.
\]

Let $x$ be an arbitrary element. Then
\[
\begin{aligned}
x\in(A\setminus B)\cap C
&\iff x\in A\setminus B\text{ and }x\in C\\
&\iff (x\in A\text{ and }x\notin B)\text{ and }x\in C\\
&\iff x\in A\text{ and }x\in C\text{ and }x\notin B\\
&\iff x\in A\cap C\text{ and }x\notin B\\
&\iff x\in(A\cap C)\setminus B.
\end{aligned}
\]
Since an arbitrary element belongs to the left-hand side exactly when it belongs to the right-hand side,
\[
\boxed{(A\setminus B)\cap C=(A\cap C)\setminus B}.
\]

\part
\[
(A\cap B)\setminus B=\varnothing.
\]

If $x\in(A\cap B)\setminus B$, then $x\in A\cap B$ and $x\notin B$.
But $x\in A\cap B$ implies $x\in B$. Thus we would have both
\[
x\in B\qquad\text{and}\qquad x\notin B,
\]
which is impossible. Therefore, there are no elements in $(A\cap B)\setminus B$, so
\[
\boxed{(A\cap B)\setminus B=\varnothing}.
\]

\part
\[
A\setminus(A\setminus B)=A\cap B.
\]

Let $x$ be an arbitrary element. Then
\[
\begin{aligned}
x\in A\setminus(A\setminus B)
&\iff x\in A\text{ and }x\notin(A\setminus B)\\
&\iff x\in A\text{ and }\neg(x\in A\text{ and }x\notin B)\\
&\iff x\in A\text{ and }(x\notin A\text{ or }x\in B)\\
&\iff x\in A\text{ and }x\in B\\
&\iff x\in A\cap B.
\end{aligned}
\]
Therefore,
\[
\boxed{A\setminus(A\setminus B)=A\cap B}.
\]

\end{parts}

